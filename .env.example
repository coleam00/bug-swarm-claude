# Optional. Turns on the owner's /api/admin/* routes (stats, hide, reset) for `bun run admin`.
# At least 16 random characters; shorter or unset keeps the routes off (404). Never commit the real one.
ADMIN_TOKEN=replace-with-a-long-random-string
# Where app.db lives. Defaults to data/ outside production; in production it is required (the mounted volume).
DATA_DIR=data
